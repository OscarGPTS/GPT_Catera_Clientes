{
  "$schema": "https://schemas.figma.com/design-tokens",
  "meta": {
    "name": "GPT Services Platform Design Tokens",
    "version": "1.0.0",
    "description": "Tokens del sistema de diseño basado en la decisión D5 del plan ejecutable v2.1",
    "brand": "GPT Services / Tech Energy Control"
  },
  "colors": {
    "gpt": {
      "50": "#FFF7ED",
      "100": "#FFEDD5",
      "200": "#FED7AA",
      "300": "#FDBA74",
      "400": "#FB923C",
      "500": "#F97316",
      "600": "#EA580C",
      "700": "#C2410C",
      "800": "#9A3412",
      "900": "#7C2D12",
      "950": "#431407"
    },
    "gpt-red": {
      "50": "#FEF2F2",
      "100": "#FEE2E2",
      "200": "#FECACA",
      "300": "#FCA5A5",
      "400": "#F87171",
      "500": "#EF4444",
      "600": "#DC2626",
      "700": "#B91C1C",
      "800": "#991B1B",
      "900": "#7F1D1D",
      "950": "#450A0A"
    },
    "slate": {
      "50": "#F8FAFC",
      "100": "#F1F5F9",
      "200": "#E2E8F0",
      "300": "#CBD5E1",
      "400": "#94A3B8",
      "500": "#64748B",
      "600": "#475569",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F172A"
    },
    "semantic": {
      "success": "#16A34A",
      "warning": "#D97706",
      "danger": "#DC2626",
      "info": "#2563EB"
    },
    "surface": {
      "primary": "#FFFFFF",
      "secondary": "#F8FAFC",
      "sidebar": "#0F172A",
      "sidebar-active": "#1E293B"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, monospace"
    },
    "fontSize": {
      "xs": { "value": "12px", "lineHeight": "16px" },
      "sm": { "value": "14px", "lineHeight": "20px" },
      "base": { "value": "16px", "lineHeight": "24px" },
      "lg": { "value": "18px", "lineHeight": "28px" },
      "xl": { "value": "20px", "lineHeight": "28px" },
      "2xl": { "value": "24px", "lineHeight": "32px" },
      "3xl": { "value": "30px", "lineHeight": "36px" },
      "4xl": { "value": "36px", "lineHeight": "40px" }
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "borderRadius": {
    "none": "0",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "borderWidth": {
    "default": "0.5px",
    "emphasis": "1px",
    "accent": "3px",
    "highlight": "2px"
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "focus-primary": "0 0 0 3px rgba(234,88,12,0.2)",
    "focus-danger": "0 0 0 3px rgba(220,38,38,0.2)"
  },
  "layout": {
    "sidebar": {
      "expanded": "256px",
      "collapsed": "64px"
    },
    "topbar": {
      "height": "64px"
    },
    "container": {
      "padding-desktop": "24px",
      "padding-mobile": "16px"
    }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "components": {
    "button": {
      "primary": {
        "background": "{colors.gpt.600}",
        "text": "#FFFFFF",
        "hover-background": "{colors.gpt.700}",
        "padding": "8px 16px",
        "borderRadius": "{borderRadius.md}",
        "fontSize": "{typography.fontSize.sm}",
        "fontWeight": "{typography.fontWeight.medium}"
      },
      "secondary": {
        "background": "transparent",
        "border": "1px solid {colors.gpt.600}",
        "text": "{colors.gpt.600}",
        "hover-background": "{colors.gpt.50}"
      },
      "critical": {
        "background": "{colors.gpt-red.600}",
        "text": "#FFFFFF",
        "hover-background": "{colors.gpt-red.700}"
      }
    },
    "input": {
      "background": "#FFFFFF",
      "border": "0.5px solid {colors.slate.200}",
      "padding": "8px 12px",
      "fontSize": "{typography.fontSize.sm}",
      "borderRadius": "{borderRadius.md}",
      "height": "36px",
      "focus-border": "{colors.gpt.600}",
      "focus-ring": "{shadows.focus-primary}"
    },
    "card": {
      "default": {
        "background": "#FFFFFF",
        "border": "0.5px solid {colors.slate.200}",
        "borderRadius": "{borderRadius.lg}",
        "padding": "16px"
      },
      "kpi-highlighted": {
        "background": "linear-gradient(135deg, {colors.gpt.50} 0%, {colors.gpt.100} 100%)",
        "border": "0.5px solid {colors.gpt.200}",
        "borderRadius": "{borderRadius.lg}",
        "padding": "14px"
      }
    },
    "badge": {
      "padding": "4px 10px",
      "borderRadius": "{borderRadius.full}",
      "fontSize": "{typography.fontSize.xs}",
      "fontWeight": "{typography.fontWeight.medium}",
      "states": {
        "borrador": { "bg": "{colors.slate.100}", "text": "{colors.slate.700}" },
        "cotizando": { "bg": "#DBEAFE", "text": "#1E40AF" },
        "cotizado": { "bg": "{colors.gpt.100}", "text": "{colors.gpt.800}" },
        "presentado": { "bg": "{colors.gpt.100}", "text": "{colors.gpt.800}" },
        "adjudicado_pendiente": { "bg": "#FEF3C7", "text": "#78350F" },
        "adjudicado_firmado": { "bg": "#DCFCE7", "text": "#14532D" },
        "en_ejecucion": { "bg": "#DCFCE7", "text": "#14532D" },
        "en_cierre": { "bg": "{colors.gpt.100}", "text": "{colors.gpt.800}" },
        "cerrado": { "bg": "{colors.slate.100}", "text": "{colors.slate.700}" },
        "cancelado": { "bg": "{colors.slate.100}", "text": "{colors.slate.500}" },
        "perdido": { "bg": "{colors.gpt-red.100}", "text": "{colors.gpt-red.800}" },
        "archivado": { "bg": "{colors.slate.100}", "text": "{colors.slate.500}" }
      }
    },
    "heatmap-cell": {
      "carga-baja": { "bg": "#DCFCE7", "text": "#14532D", "label": "0-4 proyectos" },
      "carga-media": { "bg": "#FEF3C7", "text": "#78350F", "label": "5-7 proyectos" },
      "carga-alta": { "bg": "{colors.gpt.200}", "text": "{colors.gpt.900}", "label": "8-9 proyectos" },
      "sobrecarga": { "bg": "{colors.gpt-red.200}", "text": "{colors.gpt-red.900}", "label": "10+ proyectos" }
    }
  }
}
